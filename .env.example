# ─────────────────────────────────────────
#   Codryx Store Bot - Environment Config
# ─────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env or expose your bot token.

# ─── Discord ─────────────────────────────
BOT_TOKEN=your_discord_bot_token
CLIENT_ID=your_bot_application_client_id
GUILD_ID=your_server_id

# ─── Ticket Panel / Categories ───────────
TICKET_PANEL_CHANNEL_ID=your_channel_id
TICKETS_CATEGORY_ID=your_fallback_category_id

# Dedicated category for each ticket type
PURCHASE_CATEGORY_ID=your_purchase_category_id
SUPPORT_CATEGORY_ID=your_support_category_id
INQUIRY_CATEGORY_ID=your_inquiry_category_id
CUSTOM_DEV_CATEGORY_ID=your_custom_dev_category_id
REPORT_CATEGORY_ID=your_report_category_id

# ─── Orders ──────────────────────────────
ORDERS_CATEGORY_ID=your_orders_category_id
ORDERS_LOG_CHANNEL_ID=your_orders_log_channel_id

# ─── Logs / Customer Channels ────────────
CUSTOMERS_CHANNEL_ID=your_customers_channel_id
FEEDBACK_CHANNEL_ID=your_product_feedback_channel_id
# Separate channel for support/development/management/staff ratings
TEAM_FEEDBACK_CHANNEL_ID=your_team_feedback_channel_id
TRANSCRIPT_LOG_CHANNEL_ID=your_transcript_log_channel_id
DASHBOARD_LOG_CHANNEL_ID=your_dashboard_log_channel_id
AUDIT_LOG_CHANNEL_ID=your_audit_log_channel_id

# ─── Staff Roles ─────────────────────────
OWNER_ROLE_IDS=your_owner_role_id
ADMIN_ROLE_IDS=your_admin_role_id
SUPPORT_ROLE_IDS=your_support_role_id
DEV_ROLE_IDS=your_dev_role_id
FINANCE_ROLE_IDS=your_finance_role_id
TEAM_LEADER_ROLE_IDS=your_team_leader_role_id

# Deprecated: kept for backward compatibility; ADMIN_ROLE_IDS now controls ticket/product administration.
# CLOSE_ROLE_IDS=deprecated
# DASHBOARD_ROLE_IDS=deprecated

# Multiple role IDs can be comma-separated:
# OWNER_ROLE_IDS=111111111111111111,222222222222222222

# ─── Ticket Reminder ─────────────────────
# Minutes before an unclaimed ticket receives one reminder
UNCLAIMED_TICKET_REMINDER_MINUTES=10

# ─── Branding ────────────────────────────
# Optional store logo used by embeds
STORE_LOGO_URL=https://your-image-url.example/logo.png

# Animated banner shown inside ticket opening embeds
TICKET_BANNER_URL=https://media.discordapp.net/attachments/1486029380802314380/1544325415965958207/CODRYX_animated.gif?ex=6a98c15f&is=6a976fdf&hm=36a9b668c3990d624a45f66ae6f36e13b42b544b53a6f9b096534aee31f18a16&=

# ─── Runtime ─────────────────────────────
NODE_ENV=production
