# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file or expose bot tokens/webhooks.

# Discord
DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_bot_application_client_id
GUILD_ID=your_test_server_id

# Ticket system
UNCLAIMED_TICKET_REMINDER_MINUTES=10

# Dashboard / staff authorization
DASHBOARD_ROLE_IDS=role_id_1,role_id_2
OWNER_USER_IDS=owner_user_id_1

# Optional: channels/categories used by the store
TICKETS_CATEGORY_ID=category_id
LOG_CHANNEL_ID=log_channel_id

# Optional runtime settings
NODE_ENV=production
